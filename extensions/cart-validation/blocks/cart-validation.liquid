<script src="{{ 'cart-validation.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'cart-validation.css' | asset_url }}">

<script>
  (async function () {
    function isCartDrawerOpen() {
      const cartDrawer = document.querySelector("cart-drawer, .drawer");
      return cartDrawer && cartDrawer.classList.contains("active");
    }

    async function validateCart() {
      if (window.location.pathname !== "/cart" && !isCartDrawerOpen()) {
        return;
      }

      // Fetch updated cart data
      const cartResponse = await fetch("/cart.js");
      const cart = await cartResponse.json();
      const app_url = "https://enrolled-pharmacies-constructed-comment.trycloudflare.com";

      // Send cart data for validation
      const validationResponse = await fetch(app_url + "/api/cart-validation", {
        method: "POST",
        body: JSON.stringify(cart),
        redirect: "follow",
      });

      const data = await validationResponse.json();

      console.log("Cart Validation Response:", data);

      if (data.errors && data.errors.length > 0) {
        document.dispatchEvent(new CustomEvent("cartValidationErrors", { detail: data.errors }));
      }
    }

    // Run validation on initial load
    document.addEventListener("DOMContentLoaded", () => {
      validateCart();
    });

    // Observe cart updates and reattach listeners
    const cartContainer = document.querySelector("cart-items, cart-drawer-items, cart-form");

    if (cartContainer) {
      console.log("CART CONTAINER:", cartContainer);

      const quantityInput = cartContainer.querySelector('input.quantity__input');
      quantityInput.addEventListener('change', validateCart);
    }
  })();
</script>

